;; kg_bench.lisp — Rusty side of the knowledge-graph benchmark.
;; Synthetic 3-generation family data, mirrored by kg_rdflib_bench.py:
;; load N-Triples, run the grandparent join, count solutions, time both.
;; Usage: rusty benchmarks/kg_bench.lisp (expects /tmp/rusty-kg-bench.nt,
;; generated by the python script so both sides load the IDENTICAL file).

(define (time-ms thunk)
  (let ((t0 (now-micros)))
    (let ((r (thunk)))
      (list r (/ (- (now-micros) t0) 1000)))))

(kg-clear!)
(define load-r (time-ms (lambda () (kg-load-ntriples "/tmp/rusty-kg-bench.nt"))))
(print (list 'loaded (car load-r) 'ms (cadr load-r)))

(define q-r (time-ms (lambda ()
  (length (kg-query '((?g parent ?p) (?p parent ?c)))))))
(print (list 'grandparent-solutions (car q-r) 'ms (cadr q-r)))

(define q2-r (time-ms (lambda ()
  (length (kg-query '((?x type person) (?x age ?n)))))))
(print (list 'type-age-join (car q2-r) 'ms (cadr q2-r)))

(print "KG BENCH DONE")
