(println (list 'trace-dropped (trace-dropped)))
(trace-clear)
(println (list 'trace-cleared (length (trace-report))))
(trace-off)

(println "== macro profiler ==")
(macro-profile-reset)
(macro-profile-on)
(defmacro cmdtest-prof-m (x) `(+ ,x 1))
(cmdtest-prof-m 5)
(println (list 'macro-profile-nonempty (> (length (macro-profile-report)) 0)))
(macro-profile-reset)
(println (list 'macro-profile-reset-empty (length (macro-profile-report))))
(macro-profile-off)

