(deftool-spec cmdtest-tool-add
  (list (list 'a 'number) (list 'b 'number)) '() (lambda (a b) #t) '())
(deftool-spec cmdtest-tool-print (list (list 'x 'number)) '() (lambda (x) #t) '())
(define cmdtest-spec (tool-spec (tool-name cmdtest-tool-add)))
(println (list 'tool-spec-found (pair? cmdtest-spec)))
(println (list 'spec-tool-value (procedure? (spec-tool-value cmdtest-spec))))
(println (list 'spec-param-types (spec-param-types cmdtest-spec)))
