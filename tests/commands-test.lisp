;;; commands-test.lisp — smoke-covers command-registry entries no other
;;; golden test exercises. NO LLM, no shell-run/agent/react-loop, no
;;; remember/recall/forget (owner's real ~/.rusty/memory.lisp), no
;;; defrust/defrust*/graph-compile (shell out to rustc — slow, cache-
;;; dependent). Filesystem writes are confined to /tmp/rusty-cmdtest,
;;; cleaned up at the end. Deterministic only — no timings/randomness.

